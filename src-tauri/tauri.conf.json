{
  "productName": "Chafa GUI",
  "version": "1.0.0",
  "identifier": "com.chafa.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chafa GUI",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Image to ANSI Art Converter",
    "longDescription": "A modern cross-platform GUI frontend for Chafa image-to-ANSI converter",
    "linux": {
      "deb": {
        "depends": ["chafa"]
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {}
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "externalBin": [],
    "resources": []
  },
  "plugins": {}
}
